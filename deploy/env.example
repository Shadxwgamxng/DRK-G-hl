# Wird von install.sh automatisch als deploy/.env angelegt. Datei NICHT weitergeben (enthält Passwörter).

# --- Server ---
DOMAIN="kfz.drk-goehl.de"
ACME_EMAIL="it@example.org"
APP_URL="https://kfz.drk-goehl.de"

# --- Datenbank ---
POSTGRES_PASSWORD="ZUFALLSWERT"

# --- Erst-Administrator (nur beim allerersten Start verwendet, danach entfernen) ---
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD="ZUFALLSWERT"

# --- Sonstiges ---
CRON_SECRET="ZUFALLSWERT"
UPLOAD_MAX_MB=15
SESSION_TTL_HOURS=12

# --- E-Mail (optional, für E-Mail-Benachrichtigungen) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="KFZ-Warte DRK Göhl <kfz@example.org>"

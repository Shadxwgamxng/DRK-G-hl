{
	# Browser senden bei Aufruf über eine IP keinen Servernamen mit
	default_sni {$DOMAIN}
}

# HTTPS:
#  - Domain:  Zertifikat automatisch über Let's Encrypt (TLS = E-Mail-Adresse)
#  - Nur IP:  eigenes Zertifikat (TLS = internal) → Browser zeigt einmalig eine Warnung
{$DOMAIN} {
	tls {$TLS}
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:3000
}

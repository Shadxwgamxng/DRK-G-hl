# --- Datenbank (PostgreSQL) ---
DATABASE_URL="postgresql://drk:BITTE_AENDERN@localhost:5432/drk_kfz?schema=public"

# --- Anwendung ---
# Öffentliche Basis-URL (für Links in E-Mails)
APP_URL="https://kfz.example.org"
# Verzeichnis für private Uploads (NICHT im öffentlichen Webroot!)
UPLOAD_DIR="./storage/uploads"
# Maximale Dateigröße in MB
UPLOAD_MAX_MB=15
# Sitzungsdauer in Stunden
SESSION_TTL_HOURS=12

# --- Erst-Administrator (nur beim ersten Seed verwendet) ---
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD="BITTE_SICHERES_PASSWORT_SETZEN"

# --- Geheimnis für den Erinnerungs-Endpunkt /api/cron/reminders ---
CRON_SECRET="BITTE_LANGE_ZUFAELLIGE_ZEICHENKETTE"

# --- E-Mail (optional) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="KFZ-Warte DRK Göhl <kfz@example.org>"

# --- Demo-Modus: NUR in einer separaten Demo-Datenbank verwenden ---
DEMO_MODE="false"
